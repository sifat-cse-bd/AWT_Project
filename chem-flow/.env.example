# Server Configuration
PORT=Your port number
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT= dbport number
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password
DB_NAME= your db name

# JWT Authentication
JWT_SECRET=your_big_project_very_long_secret_key
JWT_EXPIRES_IN= token expiry time


# Predefined system administrator (not available through registration)
ADMIN_ID= admin id    #Id format: ADM-009
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD= Your admin password